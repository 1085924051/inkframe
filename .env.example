# 复制为 .env 后按需填写。仅 DATABASE_URL 为必填，其余均为「预留」的模型接入配置。

# SQLite 数据库（相对 prisma/ 目录）
DATABASE_URL="file:./dev.db"

# 视频任务队列；留空时使用本地进程内 fallback
REDIS_URL=""

# 会话签名密钥（生产环境务必改成随机长字符串）
AUTH_SECRET="inkframe-dev-secret-change-me"

# 配置项加密主钥（64 位十六进制；设置后密钥类配置 AES-256-GCM 加密落库，不设则明文存储）
SETTINGS_ENCRYPTION_KEY=""

# 可信代理开关：部署在 Nginx/Caddy 等反向代理之后设为 1，限流才信任 X-Forwarded-For（否则按匿名统一计数）
TRUST_PROXY="0"

# ---- 预留：文本模型（剧本生成 / 风格蒸馏 / 分镜生成统一走 OpenAI 兼容接口）----
# 配置后自动启用真实模型，未配置时使用本地确定性生成器（也可在后台「模型配置」页填写）
LLM_API_URL=""
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_INPUT_USD_PER_MILLION=""
LLM_OUTPUT_USD_PER_MILLION=""

# vLLM is OpenAI-compatible. Example:
# LLM_API_URL="http://127.0.0.1:8000/v1"
# LLM_API_KEY="EMPTY"
# LLM_MODEL="Qwen/Qwen2.5-32B-Instruct"

# ---- 可选：PenShot 分镜服务（MIT 开源）----
PENSHOT_API_URL=""
# 自托管 PenShot 通常可留空；如果网关启用了 Bearer 鉴权则填写
PENSHOT_API_KEY=""

# ---- 预留：视频生成 Provider ----
RUNWAY_API_URL=""
RUNWAY_API_KEY=""
RUNWAY_MODEL=""
KLING_API_URL=""
KLING_API_KEY=""
KLING_MODEL="kling-v1"
SEEDANCE_API_URL=""
SEEDANCE_API_KEY=""
SEEDANCE_MODEL="doubao-seedance-1-0-pro"
